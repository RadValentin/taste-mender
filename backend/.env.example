# Paths to where AcousticBrainz dataset archives were downloaded.
# Official source: https://acousticbrainz.org/download
AB_HIGHLEVEL_ROOT=D:/Datasets/AcousticBrainz/High-level
AB_SAMPLE_ROOT=D:/Datasets/AcousticBrainz/Sample

# PostgreSQL settings
POSTGRES_USER=user
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@YOUR_HOST:5432/YOUR_DB

# Django settings
DJANGO_SECRET_KEY="django-secret-key"
DJANGO_DEBUG="True"
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# API config
## Number of submissions a track should have to be considered for daily picks.
## Set it according to dataset size (e.g. 5 for dev).
DAILY_PICKS_MIN_SUBMISSIONS=100
FEATURE_MATRIX_FILENAME="features_and_index_test.npz"

# External API keys
YOUTUBE_API_KEY="youtube-api-key"